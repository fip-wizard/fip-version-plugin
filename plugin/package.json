{
    "name": "fip-version-plugin",
    "version": "1.1.0",
    "description": "Plugin for FAIR Wizard to enable easier FIP version management and submission",
    "license": "MIT",
    "author": "Marek Suchánek",
    "type": "module",
    "scripts": {
        "build": "npm run typecheck && npm run lint && npm run build:prod",
        "build:dev": "vite build --mode development",
        "build:prod": "vite build --mode production",
        "build:watch": "vite build --watch --mode development",
        "dev": "concurrently -k \"npm run build:watch\" \"npm run serve:dist\"",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" && eslint src --fix",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
        "lint": "eslint src",
        "serve:dist": "vite preview --strictPort --port 4173",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "terser": "^5.46.2",
        "typescript": "~6.0.3",
        "vite": "^8.3.8"
    },
    "dependencies": {
        "@ds-wizard/plugin-sdk": "^0.12.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "zod": "^4.6.5"
    },
    "overrides": {
        "shell-quote": "^1.12.0"
    }
}
